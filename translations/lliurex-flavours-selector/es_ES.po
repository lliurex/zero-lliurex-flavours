#: lliurex-flavours-selector/python3-lliurexflavourselector/rsrc/ListDelegatePkgItem.qml:92
msgid "Click to show flavours"
msgstr "Haga clic para mostrar los sabores"

#: lliurex-flavours-selector/python3-lliurexflavourselector/rsrc/Loading.qml:30
