#: lliurex-flavours-selector/lliurex-flavours-selector:48
msgid "You need administration privileges to run this application."
msgstr "Necesita permisos de administración para ejecutar esta aplicación."

#: lliurex-flavours-selector/lliurex-flavours-selector:92
msgid "The device is configured as"
msgstr "El equipo está configurado como"

#: lliurex-flavours-selector/lliurex-flavours-selector:93
msgid ""
"for use in a classroom with a non standard network.\n"
"This configuration is not compatible with the Flavour Selector.\n"
"Uninstall LLIUREX-META-"
msgstr ""
"para su uso en un aula con red no normalizada.\n"
"Está configuración no es compatible con el Selector de Sabores.\n"
"Desinstale LLIUREX-META-"

#: lliurex-flavours-selector/lliurex-flavours-selector:94
msgid "and try again."
msgstr "y pruebe otra vez."

#: lliurex-flavours-selector/python3-lliurexflavourselector/rsrc/ApplicationOptions.qml:24
msgid "Home"
msgstr "Inicio"

#: lliurex-flavours-selector/python3-lliurexflavourselector/rsrc/ApplicationOptions.qml:32
msgid "View details"
msgstr "Ver detalles"

#: lliurex-flavours-selector/python3-lliurexflavourselector/rsrc/ApplicationOptions.qml:40
msgid "Help"
msgstr "Ayuda"

#: lliurex-flavours-selector/python3-lliurexflavourselector/rsrc/ApplicationOptions.qml:125
msgid "Apply"
msgstr "Aplicar"

#: lliurex-flavours-selector/python3-lliurexflavourselector/rsrc/ApplicationOptions.qml:180
msgid "Installation process has ending with errors"
msgstr "El proceso de instalación ha finalizado con errores"

#: lliurex-flavours-selector/python3-lliurexflavourselector/rsrc/ApplicationOptions.qml:182
msgid "Internet connection not detected"
msgstr "No se ha detectado conexión a Internet"

#: lliurex-flavours-selector/python3-lliurexflavourselector/rsrc/ApplicationOptions.qml:185
msgid "Uninstallation process has ending with errors"
msgstr "El proceso de desinstalación ha finalizado con errores"

#: lliurex-flavours-selector/python3-lliurexflavourselector/rsrc/ApplicationOptions.qml:187
msgid "The process has ending with errors"
msgstr "El proceso ha finalizado con errores"

#: lliurex-flavours-selector/python3-lliurexflavourselector/rsrc/ApplicationOptions.qml:189
msgid ""
"The process has ending with errors due to unresolved incompatibilities "
"between flavours"
msgstr ""
"El proceso ha finalizado con errores debido a incompatibilidades no "
"resueltas entre sabores"

#: lliurex-flavours-selector/python3-lliurexflavourselector/rsrc/ApplicationOptions.qml:191
msgid ""
"Installation process has ending successfully. It's necessary to restart the "
"system"
msgstr ""
"El proceso de instalación ha finalizado correctamente. Es necesario "
"reiniciar el equipo"

#: lliurex-flavours-selector/python3-lliurexflavourselector/rsrc/ApplicationOptions.qml:193
msgid "Checking internet connection. Wait a moment..."
msgstr "Comprobando conexión a Internet. Espere un momento..."

#: lliurex-flavours-selector/python3-lliurexflavourselector/rsrc/ApplicationOptions.qml:195
msgid "Preparing installation. Wait a moment..."
msgstr "Preparando la instalación. Espere un momento..."

#: lliurex-flavours-selector/python3-lliurexflavourselector/rsrc/ApplicationOptions.qml:197
msgid "Installing selected Flavours. Wait a moment..."
msgstr "Instalando los sabores seleccionados. Espere un momento..."

#: lliurex-flavours-selector/python3-lliurexflavourselector/rsrc/ApplicationOptions.qml:199
msgid "Uninstalling selected Flavours. Wait a moment..."
msgstr "Desinstalando los sabores seleccionados. Espere un momento..."

#: lliurex-flavours-selector/python3-lliurexflavourselector/rsrc/ApplicationOptions.qml:201
msgid ""
"Uninstallation process has ending successfully. It's necessary to restart "
"the system"
msgstr ""
"El proceso de desinstalación ha finalizado correctamente. Es necesario "
"reiniciar el equipo"

#: lliurex-flavours-selector/python3-lliurexflavourselector/rsrc/ApplicationOptions.qml:203
msgid ""
"A current installed flavour will be remove due to incompatibility with other "
"selected flavours"
msgstr ""
"Un sabor ya instalado será eliminado debido a incompatibilidad con otros "
"sabores seleccionados"

#: lliurex-flavours-selector/python3-lliurexflavourselector/rsrc/ApplicationOptions.qml:205
msgid ""
"The process has ending successfully. It's necessary to restart the system"
msgstr ""
"El proceso ha finalizado correctamente. Es necesario reiniciar el equipo"

#: lliurex-flavours-selector/python3-lliurexflavourselector/rsrc/ApplicationOptions.qml:207
msgid "Removing packages that are no longer neeed. Wait a moment..."
msgstr "Desinstalando paquetes que ya no son necesarios. Espere un momento..."

#: lliurex-flavours-selector/python3-lliurexflavourselector/rsrc/ApplicationOptions.qml:209
msgid "Activating metapackages protection. Wait a moment..."
msgstr "Activando la protección del metapaquete. Espere un momento..."

#: lliurex-flavours-selector/python3-lliurexflavourselector/rsrc/ApplicationOptions.qml:211
msgid "Assigning the laptop to cart %1. Wait a moment..."
