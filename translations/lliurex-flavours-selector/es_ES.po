msgstr "No se ha encontrado ningún sabor"

#: lliurex-flavours-selector/python3-lliurexflavourselector/rsrc/FlavoursList.qml:192
msgid "Flavours not available"
msgstr "No se ha detectado ninguna versión de sabor disponible"

