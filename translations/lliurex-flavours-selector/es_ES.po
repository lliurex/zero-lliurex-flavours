msgid "Show installed Flavours"
msgstr "Mostrar sabores instalados"

#: lliurex-flavours-selector/python3-lliurexflavourselector/rsrc/FlavoursList.qml:90
msgid "Show uninstalled Flavours"
msgstr "Mostrar sabores no instalados"

#: lliurex-flavours-selector/python3-lliurexflavourselector/rsrc/FlavoursList.qml:96
msgid "Show Flavours with error"
msgstr "Mostrar sabores con errores"

#: lliurex-flavours-selector/python3-lliurexflavourselector/rsrc/FlavoursList.qml:103
msgid "Remove filter"
msgstr "Eliminar filtro"

